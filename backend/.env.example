# Injected by the host (e.g. Railway); normally left unset in production.
PORT=4000

# Signs and verifies auth tokens. Defaults to "change-me-in-prod" when unset:
# generate a random value in production.
JWT_SECRET=change-me-in-prod

# Path to the SQLite file. Falls back to backend/data/kasa.sqlite3 when unset.
KASA_DB_PATH=./data/kasa.sqlite3

# Directory for uploaded images. Falls back to backend/public/uploads when unset.
KASA_UPLOAD_DIR=./public/uploads
